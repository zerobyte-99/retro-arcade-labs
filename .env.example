# Retro Arcade Labs - Environment Configuration
# =============================================
# WARNING: This file contains DUMMY values for local development only
# NEVER use these values in production or with real credentials

# Application Environment
NODE_ENV=development
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8470
APP_PORT=8470

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=retro_arcade
DB_USERNAME=retro_arcade
DB_PASSWORD=LOCAL_ONLY_MYSQL_PASSWORD_123
DB_ROOT_PASSWORD=LOCAL_ONLY_MYSQL_ROOT_PASSWORD_456

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=LOCAL_ONLY_REDIS_PASSWORD

# Session Configuration
SESSION_DRIVER=redis
SESSION_SECRET=LOCAL_ONLY_WEAK_SESSION_SECRET_ABC123
SESSION_LIFETIME=1209600

# JWT/Auth Configuration
JWT_SECRET=LOCAL_ONLY_WEAK_JWT_SECRET_XYZ789
JWT_EXPIRY=604800
AUTH_TOKEN_NAME=retro_arcade_token

# API Keys (ALL DUMMY - FOR LOCAL USE ONLY)
DEMO_PAYMENT_KEY=DEMO_FAKE_PAYMENT_KEY_RETRO_123
DEMO_STRIPE_KEY=DEMO_FAKE_STRIPE_KEY_456
DEMO_MAPS_KEY=DEMO_FAKE_MAPS_KEY_GOOGLE_789
DEMO_ANALYTICS_KEY=DEMO_FAKE_ANALYTICS_KEY_ABC
DEMO_CLOUDINARY_KEY=DEMO_FAKE_CLOUDINARY_XYZ
DEMO_FIREBASE_KEY=DEMO_FAKE_FIREBASE_API_KEY_123
DEMO_AWS_ACCESS_KEY=DEMO_FAKE_AWS_ACCESS_KEY_ID
DEMO_AWS_SECRET_KEY=DEMO_FAKE_AWS_SECRET_ACCESS_KEY

# Internal Service URLs (Docker internal)
INTERNAL_METADATA_URL=http://internal-metadata:8081
MOCK_MAIL_URL=http://mock-mail:8025
MOCK_MAIL_SMTP=mock-mail:1025

# File Upload Configuration
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,application/pdf
UPLOAD_PATH=./php-app/uploads
UPLOAD_URL=/uploads

# Mail Configuration (Mock)
MAIL_DRIVER=smtp
MAIL_HOST=mock-mail
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=support@retroarcade.local

# Security (Intentionally Weak for Labs)
CSRF_ENABLED=false
CORS_ENABLED=true
CORS_ORIGIN=*
RATE_LIMIT_ENABLED=false

# Cache Configuration
CACHE_DRIVER=redis
CACHE_TTL=3600

# Logging
LOG_LEVEL=debug
LOG_CHANNEL=stdout

# Vue.js Development
VUE_APP_API_URL=http://localhost:8470/api
VUE_APP_WS_URL=ws://localhost:8470
VUE_DEV_SERVER_PORT=5173

# Docker Service Names (Internal)
PHP_SERVICE=php-app
MYSQL_SERVICE=mysql
REDIS_SERVICE=redis
NGINX_SERVICE=nginx
METADATA_SERVICE=internal-metadata
MAIL_SERVICE=mock-mail